+    path = path || '';
+    depth = depth || 0;
+    if (depth > 60) return '[max depth]';
+    if (Array.isArray(v)) {
+      if (path && PII_PATH.test(path)) return v.map((x) => (x !== null && typeof x === 'object') ? '[redacted]' : pseudo(x));
