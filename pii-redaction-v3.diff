+      '.pii-bar input{width:1rem;height:1rem;cursor:pointer}' +
+      '.pii-bar .pii-note{opacity:.8}' +
+      '.pii-bar.is-off{border-color:#d9822b;background:rgba(217,130,43,.14)}';
